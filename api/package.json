{
  "name": "marketscope-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "migrate:up": "node-pg-migrate up --envPath ../.env",
    "migrate:down": "node-pg-migrate down --envPath ../.env",
    "seed": "tsx scripts/seed.ts",
    "init:setup": "npm run migrate:up && npm run seed",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "test:unit": "mocha --spec 'test/unit/**/*.test.ts'",
    "test:integration": "mocha --spec 'test/integration/**/*.test.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.19.0",
    "country-state-city": "^3.2.1",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "mocha": "^11.7.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
