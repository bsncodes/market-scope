# Postgres (used by docker-compose.yml and api/.env)
POSTGRES_DB=market_scope
POSTGRES_USER=market_scope
POSTGRES_PASSWORD=Market_Sc0pe@123
POSTGRES_PORT=5432
DATABASE_URL=postgres://market_scope:Market_Sc0pe%40123@localhost:5432/market_scope

# Redis (used by docker-compose.yml and api/.env)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# External APIs
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# External API rate limiting (token bucket: sustained rate + burst capacity)
# Nominatim allows an absolute max of 1 req/sec. 0.9 leaves margin for timing
# jitter, matching the safety gap the previous fixed 1100ms interval had.
NOMINATIM_RATE_PER_SECOND=0.9
NOMINATIM_BURST=1
OVERPASS_RATE_PER_SECOND=0.25
OVERPASS_BURST=1
OVERPASS_TIMEOUT_SECONDS=60
# Tile failures are isolated per tile and never reach the job queue, so a
# retryable response is retried here or not at all.
OVERPASS_TILE_ATTEMPTS=3
OVERPASS_TILE_RETRY_DELAY_MS=4000
OVERPASS_MAX_BACKOFF_MS=30000
OVERPASS_ELEMENT_TYPES=node,way,relation

# The status poll reads every ~10s; writing progress faster tells nobody more.
PROGRESS_WRITE_INTERVAL_MS=2000

# Discovery job retries (exponential backoff: 5s, then 10s)
DISCOVERY_JOB_ATTEMPTS=3
DISCOVERY_JOB_BACKOFF_MS=5000

# Market boundary + discovery tuning
MARKET_MAX_AREA_SQKM=30
TILE_SIZE_KM=1.5
DISCOVERY_FRESHNESS_DAYS=5
REDIS_CACHE_TTL_DAYS=1

# API
PORT=3000
